<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme for Vault -->
    <style name="Theme.Vault" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/vault_obsidian</item>
        <item name="android:navigationBarColor">@color/vault_obsidian</item>
        <item name="android:windowBackground">@color/vault_obsidian</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash Screen Starting Theme (AndroidX Core Splashscreen) -->
    <style name="Theme.Vault.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vault_obsidian</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Vault</item>
    </style>
</resources>
