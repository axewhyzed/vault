# Copy to a secret-managed deployment environment; replace every placeholder.
VAULT_DOMAIN=vault.axewhyzedlabs.co.in
VAULT_API_IMAGE=ghcr.io/axewhyzed/vault-api:latest
VAULT_WEB_IMAGE=ghcr.io/axewhyzed/vault-web:latest
DATABASE_APPLY_MIGRATIONS=true
VAULT_DB_HOST=<private-postgres-container-hostname>
VAULT_DB_PORT=5432
VAULT_DB_NAME=<dedicated-vault-database>
VAULT_DB_USER=<dedicated-vault-role>
VAULT_DB_PASSWORD=<high-entropy-url-safe-secret>
VAULT_BOOTSTRAP_EMAIL=<owner-login-email>
VAULT_BOOTSTRAP_PASSWORD=<high-entropy-url-safe-secret>
VAULT_DEPLOYED_COMMIT_SHA=<immutable-40-character-git-sha>
VAULT_TRAEFIK_TRUSTED_IP=<exact-traefik-container-ip-on-coolify-network>
# Choose an unused subnet and matching addresses after inspecting host networks.
VAULT_BACKEND_SUBNET=172.31.20.0/24
VAULT_WEB_IP=172.31.20.10
VAULT_API_IP=172.31.20.11