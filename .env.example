# Reference values; ./scripts/setup-local.ps1 generates the ignored .env file.
POSTGRES_DB=vault
POSTGRES_USER=vault
POSTGRES_PASSWORD=replace-with-a-long-random-local-secret
VAULT_BOOTSTRAP_EMAIL=owner@vault.local
VAULT_BOOTSTRAP_USERNAME=owner
VAULT_BOOTSTRAP_PASSWORD=replace-with-a-long-random-local-secret
VAULT_WEB_PORT=8080
VAULT_BIND_ADDRESS=127.0.0.1
VAULT_LAN_ORIGIN=
