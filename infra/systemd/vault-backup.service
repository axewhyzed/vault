[Unit]
Description=Vault encrypted PostgreSQL and persistent-volume backup
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/vault
UMask=0077
ExecStartPre=/usr/bin/docker compose --env-file /etc/vault/vault-backup.env --file /opt/vault/compose.backup.yaml config --quiet
ExecStart=/usr/bin/docker compose --env-file /etc/vault/vault-backup.env --file /opt/vault/compose.backup.yaml run --rm backup
TimeoutStartSec=4h
NoNewPrivileges=true
PrivateTmp=true
