# Copy to /etc/vault/vault-backup.env after replacing the placeholders.
# Keep the file root-owned and mode 0600; keep both referenced secrets outside the repo.
VAULT_BACKUP_TARGET=production
VAULT_DEPLOYED_COMMIT_SHA=<immutable-40-character-git-sha>
VAULT_DB_HOST=<private-postgres-container-hostname>
VAULT_DB_PORT=5432
VAULT_DB_NAME=<dedicated-vault-database>
VAULT_DB_USER=<dedicated-vault-role>
VAULT_DB_PASSWORD=<high-entropy-url-safe-secret>
VAULT_DB_SSLMODE=prefer
RESTIC_REPOSITORY=s3:s3.<b2-region>.backblazeb2.com/<private-bucket>/vault
RESTIC_PASSWORD_FILE=/etc/vault/restic-password
B2_CREDENTIALS_FILE=/etc/vault/b2-credentials
AWS_DEFAULT_REGION=<b2-region>
VAULT_FILE_VOLUME_NAME=vault_file_data
VAULT_DP_VOLUME_NAME=vault_data_protection_keys